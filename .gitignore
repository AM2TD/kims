# build trees
build/
build_*/
__pycache__/
*.pyc

# docs/: only the project page and its assets ship
docs/*
!docs/index.html
!docs/assets/

# datasets: only IULUI ships with the repository. MILUV, NTU VIRAL and UTIL are fetched or converted by the
# scripts in scripts/ (see README); their anchor files and experiment table are small configuration files and ship.
data/*
!data/iului/
data/miluv/*
!data/miluv/
!data/miluv/anchors_constellation*.txt
!data/miluv/experiments.csv
data/ntu/*
!data/ntu/
!data/ntu/anchors_*.txt
!data/ntu/init_poses.json
!data/ntu/init_fit.json

# run outputs: only the reference tables ship
result/*
!result/reference_tables.txt
